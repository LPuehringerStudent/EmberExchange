# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# GitHub OAuth Credentials
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Base URL for OAuth callbacks
# For local development: http://localhost:3000
# For production: https://your-domain.com
BASE_URL=http://localhost:3000

# Github API Token
GITHUB_API_TOKEN=

# Cloudflare Turnstile
# Get these from: https://dash.cloudflare.com/ → Turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Anti-Bot Configuration
# Change these to random values to rotate traps without redeploying code.
HONEYPOT_FIELDS=xk9m2p,ql4vn7
MIN_FORM_TIME_MS=3000
REQUIRED_HEADER_NAME=X-Ember-Client
REQUIRED_HEADER_VALUE=forge-v1
HONEYPOT_ENDPOINTS=/admin/bulk-delete,/free-coins,/debug/config,/internal/sessions,/auth/legacy-login,/admin/export-users

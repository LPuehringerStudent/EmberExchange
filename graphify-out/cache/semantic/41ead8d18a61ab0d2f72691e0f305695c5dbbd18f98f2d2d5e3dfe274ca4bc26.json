{"nodes": [{"id": "security_audits_security_audit_2026_06_01_audit_v1", "label": "Security Audit v1 (2026-06-01)", "file_type": "paper", "source_file": "Security_Audits/SECURITY_AUDIT_2026-06-01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "security_audits_security_audit_2026_06_01_oauth_bot_bypass", "label": "OAuth Complete Bypass of Anti-Bot Controls", "file_type": "rationale", "source_file": "Security_Audits/SECURITY_AUDIT_2026-06-01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OAuth registration skips all anti-bot controls (Turnstile, honeypots, proof-of-work) making mass bot registration trivial via puppeteer plus rotating free accounts."}, {"id": "security_audits_security_audit_2026_06_01_turnstile_fail_open", "label": "Turnstile Fail-Open Design", "file_type": "rationale", "source_file": "Security_Audits/SECURITY_AUDIT_2026-06-01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turnstile middleware returns true when TURNSTILE_SECRET_KEY is unset or Cloudflare is unreachable, silently disabling bot protection in production."}, {"id": "security_audits_security_audit_2026_06_01_requireauth_gap", "label": "No Centralized Auth Middleware", "file_type": "rationale", "source_file": "Security_Audits/SECURITY_AUDIT_2026-06-01.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No centralized isAuthenticated middleware exists; dozens of state-mutating routes are completely public, allowing arbitrary player manipulation."}], "edges": [{"source": "security_audits_security_audit_2026_06_01_audit_v1", "target": "security_audits_security_audit_2026_06_01_oauth_bot_bypass", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Security_Audits/SECURIT
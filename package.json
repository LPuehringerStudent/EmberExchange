    "@angular/forms": "^21.2.12",
    "@angular/platform-browser": "^21.2.5",
    "@angular/router": "^21.2.15",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@types/compression": "^1.8.1",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.20.0",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "chart.js": "^4.5.1",
    "compression": "^1.8.1",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "resend": "^6.12.4",
    "rxjs": "~7.8.0",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.3.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.5",
